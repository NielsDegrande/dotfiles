# Aliases are configured here and sourced from ~/.zshrc.

# Brew.
alias overbrew='brew leaves | xargs brew deps --installed --for-each | sed "s/^.*:/$(tput setaf 4)&$(tput sgr0)/"'
alias brewdump='brew bundle dump --file=-' # Print to stdout; never touches a repo's own Brewfile.

# Safety.
alias rm='echo "Use trash instead. Use command rm for real rm." #'

# Custom.
alias sourcev='source venv/bin/activate >/dev/null 2>&1 || source .venv/bin/activate >/dev/null 2>&1 || echo "Error: Failed to activate virtual environment."' # Activate venv in current folder.
alias sourcez='source ~/.zshrc' # Source zshrc in current shell.
alias dstop='docker ps -q | xargs docker stop' # Stop all docker containers.
alias retmux="tmux source-file ~/.tmux.conf"
alias reterm='cd "$HOME"; deactivate 2>/dev/null; clear'

# Exa.
alias ll='eza -la --icons --git' # Always use list and show all, add icons and git status info.
alias llt='eza --icons --tree --git-ignore' # Show tree with icons.

# FZF.
alias fzfp="fzf --preview '([[ -f {} ]] && (bat --style=numbers --color=always {} || cat {})) || ([[ -d {} ]] && (eza --tree --color=always {} | head -200)) || echo {} 2> /dev/null | head -200'"

# Git aliases.
# Only re-apply when something was actually stashed — a no-op stash followed
# by `stash apply` would apply an unrelated older stash.
alias gsp='git pull --autostash'
alias gspd='stashed=$(git stash) ; gco develop && gl ; case $stashed in Saved*) git stash apply ;; esac'
alias gspm='stashed=$(git stash) ; gco main && gl ; case $stashed in Saved*) git stash apply ;; esac'
alias gpuo="git branch --show-current | xargs git push -u origin"
alias gcm="git commit --message"

# Python.
alias pydep="where python3 | parallel 'echo {} && {} -m pip list && echo'"

# Search aliases and bindkeys.
alias searchalias="alias | fzf"
alias searchbindkey="bindkey | fzf"

# VS Code.
alias cod="code ."

# Coding agents.
alias claude="env -u TMUX CLAUDE_CODE_DISABLE_AUTO_MEMORY=0 claude --dangerously-skip-permissions"
alias codex="codex --dangerously-bypass-approvals-and-sandbox"
# Safe variants without the auto-bypass, for untrusted or unfamiliar repos:
# prompt injection in repo content then cannot run commands without approval.
alias claude-safe="env -u TMUX CLAUDE_CODE_DISABLE_AUTO_MEMORY=0 claude"
alias codex-safe="codex"

# Lov.
alias up='develop-api 2>&1 | tee api.log'
