{
  "agentPushNotifEnabled": true,
  "editorMode": "vim",
  "effortLevel": "high",
  "enabledPlugins": {
    "code-review@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "money@show-me-the-money": true,
    "posthog@claude-plugins-official": true,
    "slack@claude-plugins-official": false
  },
  "env": {
    "NODE_EXTRA_CA_CERTS": "/Users/niels/.formal/ca/localca-cert.pem"
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "repo": "openai/codex-plugin-cc",
        "source": "github"
      }
    },
    "show-me-the-money": {
      "source": {
        "repo": "iamzifei/show-me-the-money",
        "source": "github"
      }
    }
  },
  "fastMode": true,
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "bash ~/.claude/hooks/notify_idle.sh",
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "bash ~/.claude/hooks/monitor_marker.sh",
            "type": "command"
          }
        ],
        "matcher": "Monitor"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "bash ~/.claude/hooks/secret_guard.sh",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "bash ~/.claude/hooks/notify_ask_question.sh",
            "type": "command"
          }
        ],
        "matcher": "AskUserQuestion"
      },
      {
        "hooks": [
          {
            "command": "bash ~/.claude/hooks/monitor_marker.sh",
            "type": "command"
          }
        ],
        "matcher": "Monitor"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "bash ~/.claude/hooks/notify_on_finish.sh",
            "type": "command"
          }
        ]
      }
    ]
  },
  "model": "claude-fable-5[1m]",
  "permissions": {
    "defaultMode": "default",
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.env)",
      "Read(**/.envrc)",
      "Read(**/.npmrc)",
      "Read(**/.pgpass)",
      "Read(**/.docker/config.json)",
      "Read(**/.kube/**)",
      "Read(**/.config/gh/hosts.yml)",
      "Read(**/credentials.json)",
      "Read(**/secrets.json)",
      "Read(**/*secret*)",
      "Read(**/*credentials*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*_key)",
      "Read(**/*-key)",
      "Read(**/.ssh/**)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/.aws/**)",
      "Read(**/.config/gcloud/**)",
      "Read(**/.netrc)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/*.keychain*)",
      "Bash(gh pr merge:*)"
    ]
  },
  "remoteControlAtStartup": true,
  "skipDangerousModePermissionPrompt": true
}
