{
  "agentPushNotifEnabled": true,
  "cleanupPeriodDays": 365,
  "editorMode": "vim",
  "effortLevel": "high",
  "enableArtifact": false,
  "enabledPlugins": {
    "code-review@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "money@show-me-the-money": true,
    "posthog@claude-plugins-official": true,
    "slack@claude-plugins-official": false
  },
  "env": {
    "NODE_EXTRA_CA_CERTS": "/Users/niels/.formal/ca/localca-cert.pem"
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "repo": "openai/codex-plugin-cc",
        "source": "github"
      }
    },
    "show-me-the-money": {
      "source": {
        "repo": "iamzifei/show-me-the-money",
        "source": "github"
      }
    }
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "bash ~/.claude/hooks/notify_idle.sh",
            "type": "command"
          }
        ],
        "matcher": "permission_prompt|idle_prompt|elicitation_dialog|elicitation_url_dialog|agent_needs_input|quota_auto_resume_stale|quota_auto_resume_disabled"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "bash ~/.claude/hooks/monitor_marker.sh",
            "type": "command"
          }
        ],
        "matcher": "Monitor"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "bash ~/.claude/hooks/secret_guard.sh",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "bash ~/.claude/hooks/notify_ask_question.sh",
            "type": "command"
          }
        ],
        "matcher": "AskUserQuestion"
      },
      {
        "hooks": [
          {
            "command": "bash ~/.claude/hooks/monitor_marker.sh",
            "type": "command"
          }
        ],
        "matcher": "Monitor"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "bash ~/.claude/hooks/notify_on_finish.sh",
            "type": "command"
          }
        ]
      }
    ]
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "permissions": {
    "defaultMode": "default"
  },
  "remoteControlAtStartup": true,
  "showThinkingSummaries": true,
  "skipDangerousModePermissionPrompt": true,
  "voice": {
    "enabled": true,
    "mode": "tap"
  },
  "voiceEnabled": true
}
