# Functions are defined here and sourced from ~/.zshrc.

# Load .env file.
envup () {
  if [ -f .env ]
  then
    set -o allexport; source .env; set +o allexport
  fi
}

# Create new branch.
gcob() { git checkout -b "$1" --no-track origin/main; }

# Run a command with output logged to a file and tailed in a small tmux pane.
# Usage: logpane <command> [args...]
logpane() {
  if [[ $# -eq 0 ]]; then
    echo "Usage: logpane <command> [args...]"
    return 1
  fi
  if [[ -z "$TMUX" ]]; then
    echo "logpane requires tmux"
    return 1
  fi
  local logfile="/tmp/$(tmux display-message -p '#S-#W' | tr '/' '-')-$(date +%Y%m%d-%H%M%S).log"
  tmux split-window -l 35 -d "tail -f '$logfile'"
  echo "Logging to $logfile"
  "$@" > "$logfile" 2>&1
  # Ring the terminal bell so tmux highlights the window red.
  printf '\a'
}

# Mark the current tmux window as unread (activity alert).
# Waits N seconds (default 5) so you can switch away, then triggers the bell.
# Usage: unread [seconds]
unread() {
  if [[ -z "$TMUX" ]]; then
    echo "unread requires tmux"
    return 1
  fi
  local wait_seconds="${1:-5}"
  if ! [[ "$wait_seconds" =~ ^[0-9]+$ ]]; then
    echo "Usage: unread [seconds]"
    return 1
  fi
  echo "Window will be marked unread in ${wait_seconds} seconds..."
  sleep "$wait_seconds"
  printf '\a'
}

# Avoid accidentally pip installing in the base environment.
pip() {
    if [[ -z "$VIRTUAL_ENV" ]]; then
        echo "WARNING: You are not in a virtual environment. Do you want to proceed (y/n)?"
        read -r answer
        if [[ "$answer" != "y" ]]; then
            echo "Aborting pip command."
            return 1
        fi
    fi
    command pip "$@"
}

# Interactive git diff with fzf preview.
gdf() {
  git diff "$@" --color=always --name-only |
    fzf \
      --height=100% \
      --preview "git diff $* -- {-1} | delta --width=\${FZF_PREVIEW_COLUMNS}" \
      --preview-window="right,75%" || true
}

# Clean python artifacts.
pyclean () {
    find . -type f -name '*.py[co]' -delete
    find . -type d -name __pycache__ -delete
}

# JS bootstrap for a fresh worktree: real per-worktree install (never
# symlink node_modules from the main checkout — Turbopack/Vite reject deps
# resolving outside the worktree root), compiled i18n runtime, and the devenv
# install-watcher hash seeded so devenv up doesn't enter its install-restart
# loop. See AGENTS.md "Working in a Git Worktree".
_wtnew_bootstrap() {
  direnv exec . pnpm install &&
  direnv exec . pnpm --filter web run paraglide:compile &&
  mkdir -p .devenv/state &&
  shasum -a 256 pnpm-lock.yaml | cut -d' ' -f1 > .devenv/state/pnpm-lock.sha
}

# Create a new git worktree with a branch from latest origin/main.
# Usage:
#   wtnew <name> [base-branch]       Create new branch niels/<name> from origin/<base-branch>
#   wtnew -e <name> <branch>          Checkout existing branch into ../wt-<name>
#   wtnew -f <name> [base-branch]    Force recreate (removes existing worktree/branch)
#   wtnew -s <name> [...]            Skip the JS bootstrap (pnpm install etc.)
wtnew() {
  local force=false existing=false skip_bootstrap=false
  local wt_name="" base="main"
  local tmux_window="${TMUX:+$(tmux display-message -p '#{window_id}')}"
  for arg in "$@"; do
    case "$arg" in
      -h|--help)
        echo "Usage: wtnew [-f|--force] [-e|--existing] <name> [base-branch]"
        echo ""
        echo "Create a new git worktree with a branch from latest origin/main."
        echo ""
        echo "Modes:"
        echo "  wtnew <name> [base-branch]       Create new branch niels/<name> from origin/<base-branch>"
        echo "  wtnew -e <name> <branch>          Checkout existing branch into ../wt-<name>"
        echo ""
        echo "Options:"
        echo "  -f, --force       Force recreate (removes existing worktree/branch)"
        echo "  -e, --existing    Checkout an existing remote branch"
        echo "  -s, --skip-bootstrap  Skip pnpm install / paraglide / devenv hash seeding"
        echo "  -h, --help        Show this help message"
        echo ""
        echo "The worktree is created at ../wt-<name>. If inside tmux, the window is renamed."
        return 0
        ;;
      -f|--force) force=true ;;
      -e|--existing) existing=true ;;
      -s|--skip-bootstrap) skip_bootstrap=true ;;
      *) [[ -z "$wt_name" ]] && wt_name="$arg" || base="$arg" ;;
    esac
  done
  if [[ -z "$wt_name" ]]; then
    echo "Usage: wtnew [-f|--force] [-e|--existing] <name> [base-branch]"
    return 1
  fi
  cd ~/git/lov/lovable || return 1
  direnv allow .
  local wtdir="../wt-$wt_name"
  if $existing; then
    if [[ -z "$base" || "$base" == "main" ]]; then
      echo "Usage: wtnew -e <name> <branch>"
      return 1
    fi
    git fetch origin "$base" && \
    git worktree add "$wtdir" "$base" && \
    cd "$wtdir" || return 1
    git lfs install --local --force
    git lfs pull
    direnv allow
    $skip_bootstrap || _wtnew_bootstrap
    [[ -n "$tmux_window" ]] && tmux rename-window -t "$tmux_window" "$wt_name"
  else
    if $force; then
      git worktree remove "$wtdir" 2>/dev/null
      git branch -D "niels/$wt_name" 2>/dev/null
    fi
    git fetch origin "$base" && \
    git worktree add --no-track -b "niels/$wt_name" "$wtdir" "origin/$base" && \
    cd "$wtdir" || return 1
    git lfs install --local --force
    git lfs pull
    direnv allow
    $skip_bootstrap || _wtnew_bootstrap
    [[ -n "$tmux_window" ]] && tmux rename-window -t "$tmux_window" "$wt_name"
  fi
}

# Fix repeated `git fetch` errors like:
#   error: fetching ref refs/remotes/origin/<user>/<branch> failed: incorrect old value provided
# Cause is usually a branch-casing rename on GitHub colliding on the
# case-insensitive filesystem; the same error also appears
# transiently when concurrent fetches (agent worktrees) race on a ref.
# Deletes the failing remote-tracking refs — every case variant, loose and
# packed — then refetches. Remote-tracking refs only, so it's always safe.
# Usage: gfixrefs [remote]
gfixrefs() {
  local remote="${1:-origin}"
  local gitdir
  gitdir=$(git rev-parse --path-format=absolute --git-common-dir) || return 1
  local out
  out=$(git fetch "$remote" --prune 2>&1)
  local -a bad
  bad=("${(@f)$(print -r -- "$out" | sed -n 's/^error: fetching ref \(refs\/[^ ]*\) failed: incorrect old value.*/\1/p' | sort -u)}")
  bad=("${(@)bad:#}")
  if (( ${#bad[@]} == 0 )); then
    echo "fetch clean — was likely a transient race between concurrent fetches"
    return 0
  fi
  echo "resetting ${#bad[@]} broken remote-tracking ref(s):"
  local ref variant
  for ref in "${bad[@]}"; do
    echo "  $ref"
    # Delete every case variant git knows about (handles loose and packed).
    git for-each-ref --format='%(refname)' "refs/remotes/$remote" |
      grep -ixF -- "$ref" |
      while IFS= read -r variant; do git update-ref -d "$variant" 2>/dev/null; done
    # packed-refs can hold an old-casing entry that for-each-ref no longer
    # reports once the loose file wins the case-insensitive lookup.
    if [[ -f "$gitdir/packed-refs" ]]; then
      awk -v r="$ref" 'tolower($2) == tolower(r) { print $2 }' "$gitdir/packed-refs" |
        while IFS= read -r variant; do git update-ref -d "$variant" 2>/dev/null; done
    fi
    # Leftover loose file under an old-casing directory (rm is aliased to trash).
    command rm -f "$gitdir/$ref" 2>/dev/null
  done
  # Drop now-empty old-casing directories so enumeration and lookup agree again.
  find "$gitdir/refs/remotes/$remote" -type d -empty -delete 2>/dev/null
  git fetch "$remote" --prune
}

# Remove git worktrees by short name.
# Usage:
#   wtrm [-f|--force] <name> [name...]  Remove ../wt-<name> worktrees
#   wtrm [-f|--force] -a|--all          Remove all worktrees (except the main one)
wtrm() {
  local force=()
  local all=0
  local names=()
  for arg in "$@"; do
    case "$arg" in
      -f|--force) force=(--force) ;;
      -a|--all) all=1 ;;
      -*) echo "Unknown option: $arg"; return 1 ;;
      *) names+=("$arg") ;;
    esac
  done
  if [[ $all -eq 0 && ${#names[@]} -eq 0 ]]; then
    echo "Usage: wtrm [-f|--force] <name> [name...]  or  wtrm [-f|--force] -a|--all"
    return 1
  fi
  cd ~/git/lov/lovable || return 1
  local main_wt
  main_wt=$(git worktree list | head -1 | awk '{print $1}')
  cd "$main_wt" || return 1
  if [[ $all -eq 1 ]]; then
    git worktree list | tail -n +2 | awk '{print $1}' | while read -r wt; do
      echo "Removing $wt"
      git worktree remove "${force[@]}" "$wt"
    done
  else
    for name in "${names[@]}"; do
      local wtdir="../wt-$name"
      if [[ -d "$wtdir" ]]; then
        echo "Removing $wtdir"
        git worktree remove "${force[@]}" "$wtdir"
      else
        echo "Worktree $wtdir not found"
      fi
    done
  fi
}
