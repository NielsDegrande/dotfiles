# Paths are configured here and sourced from ~/.zshrc.

# Go.
# export GOPATH="${HOME}/.go"
# Below is hardcoded from $(brew --prefix golang) as it is slow.
# export GOROOT="/opt/homebrew/opt/go/libexec"
# export PATH="$PATH:${GOPATH}/bin:${GOROOT}/bin"

# nvm. Lazy-load: sourcing nvm.sh eagerly costs ~300-500 ms on every shell start.
# The wrappers self-destruct and load the real nvm on first use.
export NVM_DIR="$HOME/.nvm"
_load_nvm() {
  unset -f nvm node npm npx _load_nvm
  [ -s "/opt/homebrew/opt/nvm/nvm.sh" ] && \. "/opt/homebrew/opt/nvm/nvm.sh"
  [ -s "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm" ] && \. "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm"
}
nvm() { _load_nvm; nvm "$@"; }
node() { _load_nvm; node "$@"; }
npm() { _load_nvm; npm "$@"; }
npx() { _load_nvm; npx "$@"; }

# Python.
# uv.
export PATH="/Users/niels/.local/bin:$PATH"

# Rust.
export PATH="$PATH:$HOME/.cargo/bin"

